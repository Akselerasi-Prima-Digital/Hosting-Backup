# Hosting User Backup Script Configuration (.env)
# Panel
PANEL_TYPE=auto
# auto | cpanel | directadmin
# PANEL_USERNAME=your_cpanel_or_da_user
# If left blank, the current logged-in user is used.
# PANEL_HOME_DIR=/home/your_cpanel_or_da_user
# If left blank, $HOME is used.
# max wait for backup, seconds
BACKUP_TIMEOUT_SECONDS=600
BACKUP_POLL_INTERVAL_SECONDS=3
# delete local archive after verified upload
DELETE_LOCAL_AFTER_UPLOAD=true
# stable-size polls before considered done
BACKUP_STABLE_CHECKS=2

# Curl transfer hardening (all storage drivers)
CURL_CONNECT_TIMEOUT=30
CURL_STALL_TIMEOUT=120
CURL_RETRIES=2

# Storage type: s3 | ftp | ftps | sftp
STORAGE_TYPE=s3

# Option 1: S3 (when STORAGE_TYPE=s3)
S3_PROTOCOL=https
# s3.amazonaws.com, wasabi, etc.
S3_ENDPOINT=storage.yourserver.com
S3_KEY=your_s3_access_key_here
S3_SECRET=your_s3_secret_key_here
S3_BUCKET=your_bucket_name
# S3_PATH=/your_username/YYYY-MM-DD/
# If left blank, files are stored under /username/YYYY-MM-DD/ (real username and today's date).
S3_USE_PATH_STYLE=false
# true = endpoint/bucket, false = bucket.endpoint
S3_SIGN_VERSION=v4
# v4 (default) | v2 (legacy)
S3_REGION=us-east-1

# Option 2: FTP / FTPS (when STORAGE_TYPE=ftp or ftps)
FTP_HOST=ftp.yourserver.com
FTP_PORT=21
FTP_USERNAME=ftp_backup_user
FTP_PASSWORD=your_ftp_password
FTP_SSL=true
# FTP_PATH=/backups/your_username/YYYY-MM-DD/
# If left blank, files are stored under /backups/username/YYYY-MM-DD/ (real username and today's date).

# Option 3: SFTP (when STORAGE_TYPE=sftp)
SFTP_HOST=sftp.yourserver.com
SFTP_PORT=22
SFTP_USERNAME=sftp_backup_user
SFTP_PASSWORD=your_ssh_password
# SFTP_PATH=/backups/your_username/YYYY-MM-DD/
# If left blank, files are stored under /backups/username/YYYY-MM-DD/ (real username and today's date).
# Disable SSH host-key verification (MITM risk). Set false to enforce host-key
# checking (requires host in ~/.ssh/known_hosts).
SFTP_INSECURE=true

# DirectAdmin (optional, for DirectAdmin API trigger)
DA_HOST=127.0.0.1
DA_PORT=2222
DA_SSL=true
DA_PASSWORD=your_da_password_or_login_key

# Telegram (optional). Bot token from @BotFather, chat ID from @userinfobot/@myidbot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging. Empty = console only.
# LOG_FILE=/home/username/logs/backup.log